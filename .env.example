# ═══════════════════════════════════════════════════════════════
# INEMA Financial Solutions — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ═══════════════════════════════════════════════════════════════

# ─── SUPABASE ────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ─── APP ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel, set this to: https://your-domain.vercel.app

# ─── EMAIL (optional, for notifications) ─────────────────────
# Get from: https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=noreply@inemafinance.rw
INEMA_CONTACT_EMAIL=inemafinancialsolutionsltd@gmail.com
